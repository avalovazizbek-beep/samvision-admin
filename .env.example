# Admin panel sozlamalari (bu yerda HECH QANDAY maxfiy ma'lumot bo‘lmasligi kerak —
# VITE_ bilan boshlangan qiymatlar brauzerga ochiq holda tushadi).

# Backend API manzili. Bo‘sh qoldirilsa "/api" ishlatiladi (dev rejimida Vite proksi orqali,
# production'da Nginx orqali bir domenda). Backend alohida domenda bo‘lsa: https://api.example.uz/api
# (u holda backend .env dagi CORS_ORIGINS ga admin panel manzilini qo‘shing)
VITE_API_URL=

# Dev rejimida /api so‘rovlari yo‘naltiriladigan backend
VITE_DEV_BACKEND=http://localhost:4800

# Ro‘yxatdan o‘tish sahifasi (frontend) manzili — admin menyusidagi havola uchun (ixtiyoriy)
VITE_PUBLIC_SITE_URL=

# Logotip manzili (standart: /logo.svg — public/logo.svg faylini joylang)
VITE_LOGO_URL=
